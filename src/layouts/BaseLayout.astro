---
import "@fortawesome/fontawesome-free/css/all.min.css";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MotionEffects from "../components/MotionEffects.astro";
import { siteConfig } from "../config/site";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  stickyHeader?: boolean;
}

const {
  title,
  description = siteConfig.defaultDescription,
  bodyClass = "",
  stickyHeader = false,
} = Astro.props;
const pageTitle = `${title} | ${siteConfig.name}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={["research-page", "overflow-x-hidden", bodyClass]}>
    <Header currentPath={Astro.url.pathname} sticky={stickyHeader} />
    <slot />
    <Footer currentPath={Astro.url.pathname} />
    <MotionEffects />
  </body>
</html>
