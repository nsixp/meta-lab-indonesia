      <!-- PERAN & TANGGUNG JAWAB -->
      <section id="peran" class="responsibility-section">
        <div class="research-shell responsibility-shell">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <div class="lg:col-span-2">
              <h2 class="text-3xl font-extrabold text-gray-900 mb-2">
                Peran &amp; Tanggung Jawab
              </h2>
              <div class="section-underline mb-4"></div>
              <p class="text-gray-500 text-sm mb-8">
                Struktur organisasi yang terstruktur untuk memastikan efisiensi
                kerja dan kualitas publikasi ilmiah tingkat internasional.
              </p>

              <div class="space-y-4">
                <!-- Koordinator -->
                <div
                  class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 card-hover flex gap-4 items-start"
                >
                  <div
                    class="w-12 h-12 rounded-full peran-icon-purple flex items-center justify-center flex-shrink-0"
                  >
                    <i class="fa-solid fa-user-tie text-purple-600 text-lg"></i>
                  </div>
                  <div>
                    <h4 class="font-bold text-gray-900 text-sm mb-1">
                      Koordinator Riset
                    </h4>
                    <p class="text-gray-500 text-xs leading-relaxed mb-1">
                      Bertanggung jawab atas keseluruhan arah dan koordinasi
                      proyek riset. Mengawasi distribusi tugas, monitoring
                      kemajuan, dan menjamin kualitas akademik setiap tahap.
                    </p>
                    <p class="text-gray-400 text-xs leading-relaxed italic">
                      Keterampilan manajemen proyek, komunikasi strategis, dan
                      pemahaman mendalam terhadap standar publikasi SCI/SSCI.
                    </p>
