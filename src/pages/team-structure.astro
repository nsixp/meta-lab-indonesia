---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Struktur Tim"
  description="Struktur organisasi dan anggota tim riset Meta Lab Indonesia."
  bodyClass="site-page structure-page"
>
<main>
      <section id="hero" class="structure-hero inner-hero">
        <div class="hero-pattern pattern-left" aria-hidden="true"></div>
        <div class="hero-pattern pattern-right" aria-hidden="true"></div>
        <div class="research-shell structure-hero-grid">
          <div class="inner-hero-copy">
            <span class="eyebrow"
              ><i class="fa-solid fa-sitemap"></i> Organisasi Kolaboratif</span
            >
            <h1>Struktur <span>Tim</span></h1>
            <p>
              Sinergi 5 pilar riset profesional di bawah koordinasi strategis
              untuk menjamin kualitas publikasi ilmiah internasional.
            </p>
            <div class="hero-chips">
              <span
                ><i class="fa-solid fa-people-group"></i> Lintas Institusi</span
              ><span><i class="fa-solid fa-gears"></i> Peran Terarah</span>
            </div>
          </div>
          <div
            class="structure-hero-visual"
            aria-label="Ilustrasi struktur organisasi Meta Lab Indonesia"
          >
            <div class="structure-scene-halo" aria-hidden="true"></div>
            <div class="structure-orbit orbit-outer" aria-hidden="true"></div>
            <div class="structure-orbit orbit-inner" aria-hidden="true"></div>

            <div class="structure-org-panel" aria-hidden="true">
              <span class="org-panel-lead"
                ><i class="fa-solid fa-user-tie"></i
              ></span>
              <span class="org-panel-line"></span>
              <div class="org-panel-nodes">
                <i></i><i></i><i></i><i></i><i></i>
              </div>
            </div>

            <div class="structure-scientists" aria-hidden="true">
              <div class="structure-person structure-person-left">
                <i class="fa-solid fa-user-graduate"></i>
              </div>
              <div class="structure-person structure-person-main">
                <i class="fa-solid fa-user-doctor"></i>
              </div>
              <div class="structure-person structure-person-right">
                <i class="fa-solid fa-user"></i>
              </div>
            </div>

            <div class="structure-laptop" aria-hidden="true">
              <div><i class="fa-solid fa-sitemap"></i></div>
              <span></span>
            </div>
            <div class="structure-book-stack" aria-hidden="true">
              <span>TEAM WORK</span><span>DATA &amp; METHODS</span
              ><span>PUBLICATION</span>
            </div>
            <div class="structure-microscope" aria-hidden="true">
              <i class="fa-solid fa-microscope"></i>
            </div>
            <div class="structure-lab-tools" aria-hidden="true">
              <i class="fa-solid fa-flask"></i><i class="fa-solid fa-vial"></i>
            </div>

            <span class="team-node node-writing" aria-hidden="true"
              ><i class="fa-solid fa-file-pen"></i
            ></span>
            <span class="team-node node-analysis" aria-hidden="true"
              ><i class="fa-solid fa-chart-column"></i
            ></span>
            <span class="team-node node-developer" aria-hidden="true"
              ><i class="fa-solid fa-code"></i
            ></span>
            <span class="team-node node-hr" aria-hidden="true"
              ><i class="fa-solid fa-users-gear"></i
            ></span>
          </div>
        </div>
      </section>

      <!-- ORG CHART -->
      <section id="org-chart" class="structure-chart-section">
        <div class="research-shell structure-chart-shell">
          <div class="site-section-heading compact-heading">
            <span class="section-kicker">Kolaborasi Lima Pilar</span>
            <h2>Bagan Organisasi</h2>
            <p>
              Setiap tim memiliki fokus yang berbeda dan bergerak dalam satu
              koordinasi riset yang terintegrasi.
            </p>
          </div>
          <!-- Koordinator -->
          <div class="flex justify-center mb-4">
            <div
              class="bg-white rounded-2xl shadow-lg border border-gray-100 p-5 flex items-center gap-5 w-96 max-w-md card-hover"
            >
              <img
                src="/images/siti-jamiatul-husnaini.png"
                class="member-avatar w-16 h-16 flex-shrink-0"
                alt="Koordinator"
                style="border: 3px solid #8b5cf6"
              />
              <div>
                <span
                  class="coord-badge text-purple-700 font-bold text-xs px-3 py-1 rounded-full block mb-4 w-fit"
                  >Koordinator Riset</span
                >
                <p class="font-bold text-gray-900 text-sm">
                  National Taiwan University of Science and Technology
                </p>
                <p class="text-gray-600 text-xs mt-1">Siti Jamiatul Husnaini</p>
              </div>
            </div>
          </div>

          <!-- Tree connector -->
          <div class="tree-line w-0 mx-auto"></div>
          <div class="flex justify-center">
            <div class="tree-h-line w-4/5 max-w-4xl"></div>
          </div>

          <!-- 5 Team Columns -->
          <div
