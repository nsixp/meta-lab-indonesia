              <div class="p-4 bg-blue-50">
                <div class="flex items-center gap-2 mb-2">
                  <i class="fa-solid fa-pen-to-square text-blue-600"></i>
                  <h4 class="font-extrabold text-gray-900 text-sm">
                    Writing Team
                  </h4>
                </div>
                <p class="text-gray-500 text-xs">
                  Naskah akademik &amp; jurnal SCI/SSCI
                </p>
              </div>
              <div class="p-4 space-y-3">
                <div>
                  <p class="text-gray-400 text-xs font-semibold mb-2">
                    National Taiwan University of Science and Technology
                  </p>
                  <div class="flex items-center gap-2">
                    <img
                      src="/images/siti-jamiatul-husnaini.png"
                      class="member-avatar"
                      alt=""
                    />
                    <p class="text-gray-700 text-xs font-medium">
                      Siti Jamiatul Husnaini
                    </p>
                  </div>
                </div>
                <div class="border-t border-gray-100 pt-3">
